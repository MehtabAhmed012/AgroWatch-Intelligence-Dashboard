# ---- Google Earth Engine ----
GEE_PROJECT=semiotic-timer-429307-g6
# Local dev: leave the three below empty and run `earthengine authenticate` once.
# Production: service account registered for Earth Engine.
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=
# Or the whole JSON key on one line (best for Render / Cloud Run):
GEE_PRIVATE_KEY_JSON=

# ---- Boundary asset (the service account must be able to READ it) ----
BOUNDARY_ASSET=projects/semiotic-timer-429307-g6/assets/District_Boundary
# Leave blank to auto-detect the column names, or set them exactly:
PROVINCE_FIELD=
DISTRICT_FIELD=
DEFAULT_PROVINCE=Punjab

# ---- CORS: comma-separated frontend origins ----
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080

# ---- Dashboard login (optional) ----
AUTH_ENABLED=false
JWT_SECRET=change-me-to-a-long-random-string
DASH_USER=admin
# python -c "from werkzeug.security import generate_password_hash as g; print(g('yourpassword'))"
# Keep the single quotes - the hash contains $ characters.
DASH_PASS_HASH=''

# ---- Seasons (crop calendar, MM-DD). Any other window can be chosen in the filter bar ----
KHARIF_START=05-01
KHARIF_END=10-31
RABI_START=11-01
RABI_END=04-30

# ---- Cropland mask: worldcover | dynamicworld | intersect | union ----
CROP_SOURCE=worldcover
DW_CROP_START=2021-01-01
DW_CROP_END=2024-01-01
DW_CROP_THRESHOLD=0.5

# ---- Soil moisture dataset (check with python verify_datasets.py) ----
SMAP_ID=NASA/SMAP/SPL4SMGP/008

# ---- Exports (leave false on a public deployment; each export uses your Earth Engine quota) ----
EXPORTS_ENABLED=false
# Drive exports go to the Drive of the account that owns the Earth Engine credentials. With a service
# account, export to a Cloud Storage bucket instead:
EXPORT_GCS_BUCKET=
